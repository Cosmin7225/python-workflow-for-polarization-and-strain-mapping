    "#import necessary libraries\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import hyperspy.api as hs\n",
    "import atomap.api as am\n",
    "from scipy.stats import gaussian_kde\n",
    "from atomap.tools import remove_atoms_from_image_using_2d_gaussian\n",
    "import matplotlib.tri as mtri\n",
    "#import matplotlib\n",
    "#matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.spatial import cKDTree"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cf06f254",
   "metadata": {},
   "source": [
    "Loading the image and setting the sampling and units and calibrate the image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "6e44e125",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "sampling, units = 0.0183, 'nm' \n",
    "s = hs.load(r'D:\\Articol ultramicroscopy\\Frame 067dif1.jpg')\n",
    "if s.data.ndim == 3:\n",
    "    s.data = np.mean(s.data, axis=12)\n",
    "\n",
    "s.axes_manager[0].scale = sampling\n",
    "s.axes_manager[1].scale = sampling\n",
    "s.axes_manager[0].units = units\n",
    "s.axes_manager[1].units = units"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0f740174",
   "metadata": {},
   "source": [
    "Create a copy of the image data and convert to float if necessary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "58837548",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "img = s.data\n",
    "if img.dtype != np.float32 and img.dtype != np.float64:\n",
    "    img = img.astype(np.float32)\n",
    "h, w = img.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04cff6a5",
   "metadata": {},
   "source": [
    "Determine the positions of the atoms in the image using atomap, based on the separation of the atoms in the image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "7ebfb28f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "fb51c1c9402c4a73b46de7dadf61d80f",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "Gaussian fitting:   0%|          | 0/5848 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "A_positions = am.get_atom_positions(s, separation=12) #adjust properly for your image (20 is a good starting point for 1024x1024 images)\n",
    "subA = am.Sublattice(A_positions, image=img, color=\"r\")\n",
    "subA.find_nearest_neighbors()\n",
    "subA.refine_atom_positions_using_2d_gaussian()\n",
    "subA.construct_zone_axes()\n",
    "A = np.array(subA.atom_positions, dtype=float)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "72301b55",
   "metadata": {},
   "source": [
    "Estimate the displacement field between the atoms and their nearest neighbors and store the results in a list this gives us a list of displacements in the x and y directions, as well as the distance between the atom and its nearest neighbor we will use this list to create a density plot of the displacements, which will help us visualize the strain in the material"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "4a40977b",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "disp = []\n",
    "for atom in subA.atom_list:\n",
    "    nn = atom.nearest_neighbor_list\n",
    "    if nn is None:\n",
    "        continue\n",
    "    ax, ay = atom.pixel_x, atom.pixel_y\n",
    "    for n in nn[:6]:  ,
    "        dx = n.pixel_x - ax\n",
    "        dy = n.pixel_y - ay\n",
    "        r = (dx*dx + dy*dy)**0.5\n",
    "        if r > 1e-6:\n",
    "            disp.append([dx, dy, r])\n",
    "\n",
    "disp = np.array(disp, dtype=float)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "61d2a617",
   "metadata": {},
   "source": [
    "Keep only the closest 20-40% of the displacements (the first ring)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "0da14361",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "rmin = np.percentile(disp[:,2], 20)\n",
    "rmax = np.percentile(disp[:,2], 40)\n",
    "disp = disp[(disp[:,2] >= rmin) & (disp[:,2] <= rmax)]\n",
    "\n",
    "disp = np.array(disp, dtype=float)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bae3e4f6",
   "metadata": {},
   "source": [
    "Visualiztion of the neighbor displacement cloud"
