   "source": [
    "\n",
    "\n",
    "za0, za1 = subA.zones_axis_average_distances[0:2]\n",
    "v0 = np.array(za0, float)\n",
    "v1 = np.array(za1, float)\n",
    "ang = np.degrees(np.arccos(np.clip(np.dot(v0, v1) / (np.linalg.norm(v0)*np.linalg.norm(v1)), -1, 1)))\n",
