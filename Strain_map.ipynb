   "source": [
    "\n",
    "dx = disp[:,0]\n",
    "dy = disp[:,1]\n",
    "\n",
    "plt.figure(figsize=(5,5))\n",
    "plt.scatter(dx, dy, s=5, alpha=0.3)\n",
